# ============================================================
# VTC 服务端 · Rust · 环境变量示例
# 复制为 .env 并按车队实际填写。字段与 .NET 版对齐。
# ============================================================

# ---- 服务 ----
# 监听端口
PORT=8731
# 对外基址（预签名 URL / 回调地址用）
PUBLIC_BASE=http://127.0.0.1:8731
# 日志级别（RUST_LOG：trace/debug/info/warn/error）
RUST_LOG=info

# ---- 认证 ----
# JWT 签名密钥（≥32 字符，必须改！生产用随机值）
# 生成：openssl rand -base64 48
JWT_SECRET=CHANGE_ME_to_a_long_random_secret_at_least_32_chars
# 初始管理员
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=ChangeMe123!
# 登录限流窗口（秒，默认 60）与阈值（默认 5 次）
AUTH_RATE_WINDOW=60
AUTH_RATE_LIMIT=5
# AUTH_MODE：hybrid(默认，密码+可选绑定) / steam(强制Steam) / tmp(强制TM:MP)
# 对应 require 开关
AUTH_REQUIRE_TMP=false
AUTH_REQUIRE_STEAM=false

# ---- 车队品牌 ----
TEAM_NAME=默认车队
TEAM_SLOGAN=松散，自由的行驶、玩耍
TEAM_SLUG=default
TEAM_LOGO=pack://app-assets/brand/logo.png
TEAM_LOGIN_BG=pack://app-assets/brand/login_bg.jpg
TEAM_LOGIN_LAYOUT=left
TEAM_ACCENT_COLOR=#1E88E5
TEAM_DEFAULT_LANG=zh-CN

# ---- 存储 ----
# local（默认，本地目录）/ s3（P1）
STORAGE_PROVIDER=local
STORAGE_DIR=./storage
# local 预签名 HMAC 密钥（≥32 字符）
VTC_STORAGE_SIGN_KEY=CHANGE_ME_storage_sign_key_32_chars_min
# s3（P1，STORAGE_PROVIDER=s3 时启用）
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ---- 数据库 ----
# SQLite 文件路径（Docker 内 /data/vtc.db）
DB_PATH=./vtc.db

# ---- DLC ----
# 地图类 DLC 模板目录（含 <major>.<game>.txt）
MAP_DLC_DIR=../map-dlc

# ---- 更新 / 渠道 ----
UPDATE_CHANNEL=stable

# ---- 功能开关（车队级） ----
FEATURE_ALLOW_UPLOAD=true
FEATURE_TMP_BINDING=true
FEATURE_RSS_ENABLED=true
